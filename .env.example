# Application under test — Automation Exercise (public demo marketplace)
TEST_ENV=prod
BASE_URL=https://www.automationexercise.com
API_BASE_URL=https://www.automationexercise.com/api

# Browser
HEADLESS=true
BROWSER=chromium
SLOW_MO_MS=0
DEFAULT_TIMEOUT_MS=15000

# HTTP
HTTP_TIMEOUT_S=20

# Recordings of the end-to-end cases: one WebM and one Playwright trace each.
# Off by default — they cost disk on every run and are only wanted when a run
# is going to be published or stepped through.
RECORD_VIDEO=false
VIDEO_DIR=videos
TRACE_DIR=traces
