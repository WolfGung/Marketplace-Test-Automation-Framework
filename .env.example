# Target. `local` is the stand in stand/ (started by the suite when nothing
# answers on the port); `prod` is the public demo site, for the drift check only.
TEST_ENV=local
BASE_URL=http://127.0.0.1:8092
API_BASE_URL=http://127.0.0.1:8092/api

# Browser
HEADLESS=true
BROWSER=chromium
SLOW_MO_MS=0
DEFAULT_TIMEOUT_MS=15000

# HTTP
HTTP_TIMEOUT_S=20

# Recordings of the end-to-end cases: one WebM and one Playwright trace each.
# Off by default — they cost disk on every run and are only wanted when a run
# is going to be published or stepped through.
RECORD_VIDEO=false
VIDEO_DIR=videos
TRACE_DIR=traces
